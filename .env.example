# 项目端口
PORT=1024

# 数据库配置
DATABASE_URI=postgresql+psycopg2://<YOUR_DATABASE_USERNAME>:<YOUR_DATABASE_PASSWORD>@<YOUR_DATABASE_HOST>:<YOUR_DATABASE_PORT>/<YOUR_DATABASE_NAME>

# 登录配置
ALGORITHM=HS256
LOGIN_SECRET=<YOUR_LOGIN_SECRET>

# Google 登录组织限制
GOOGLE_ORG_ALLOW_LIST=["airjelly.ai"]
# 必须同时匹配 Google Token 的 hd 和邮箱域名；[] 拒绝所有 Google 登录/绑定。

# CORS Origins
CORS_ORIGINS=["http://localhost:9000"]

# Google auth
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# 邮件服务器配置
MAIL_SERVER=<YOUR_MAIL_SERVER>
MAIL_PORT=<YOUR_MAIL_PORT>
MAIL_USERNAME=<YOUR_MAIL_USERNAME>
MAIL_PASSWORD=<YOUR_MAIL_PASSWORD>
MAIL_USE_TLS=True
MAIL_DEFAULT_SENDER=<YOUR_MAIL_DEFAULT_SENDER>

# 模型服务
ARK_BASE_URL_CN=https://ark.cn-beijing.volces.com/api/v3
ENDPOINT_ID=deepseek-v4-flash-ga-260731
ARK_API_KEY=<YOUR_ARK_API_KEY>
